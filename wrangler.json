{
  "name": "poc-digital",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "previews": {},
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
  "main": "src/worker.mjs",
  "vars": {
    "TURNSTILE_HOSTNAMES": "pocdigital.org,www.pocdigital.org",
    "CONTACT_TO": "john@pocdigital.org",
    "CONTACT_FROM": "no-reply@forms.pocdigital.org"
  },
  "send_email": [
    {
      "name": "CONTACT_EMAIL",
      "destination_address": "john@pocdigital.org"
    }
  ]
}
